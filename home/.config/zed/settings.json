{
  "cli_default_open_behavior": "new_window",
  "disable_ai": true,
  "proxy": "",
  "tab_bar": {
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": false
  },
  "tabs": {
    "file_icons": false,
    "git_status": true
  },
  "show_whitespaces": "all",
  "minimap": {
    "thumb": "always",
    "show": "auto"
  },
  "diff_view_style": "split",
  "project_panel": {
    "indent_size": 10.0,
    "git_status_indicator": true,
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "git_panel": {
    "show_count_badge": false,
    "file_icons": false,
    "status_style": "icon",
    "button": true,
    "tree_view": true,
    "dock": "left"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha"
  },
  "edit_predictions": {
    "provider": "zed"
  },
  "base_keymap": "VSCode",
  "telemetry": {
    "metrics": false,
    "diagnostics": false
  },
  "vim_mode": false,
  "tab_size": 2,
  "unnecessary_code_fade": 0.7,
  "indent_guides": {
    "background_coloring": "disabled",
    "enabled": true,
    "coloring": "indent_aware"
  },
  "agent": {
    "dock": "right",
    "default_profile": "ask",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4"
    }
  },
  "ui_font_size": 14.0,
  "ui_font_weight": 600.0,
  "buffer_font_size": 13.0,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_family": "JetBrainsMono Nerd Font",
  "theme": {
    "mode": "dark",
    "light": "Tokyo Night Light",
    "dark": "Tokyo Night"
  },
  "buffer_font_features": {
    "liga": false,
    "calt": false
  },
  "formatter": "language_server",
  "terminal": {
    "working_directory": "current_project_directory"
  },
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "classAttributes": [ "class", "className", "cva", "cn" ],
        "classFunctions": ["cva", "cx"],
        "experimental": {
          "classRegex": [
            "[cls|className]\\s\\:\\=\\s\"([^\"]*)",
            "\\.classList\\.add\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.contains\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.remove\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.replace\\([^,)]+,\\s*['\"]([^'\"]*)['\"]",
            "\\.classList\\.replace\\(\\s*['\"]([^'\"]*)['\"]",
            "\\.classList\\.toggle\\(['\"]([^'\"]*)['\"]",
            "\\.className\\s*[+]?=\\s*['\"]([^'\"]*)['\"]",
            "\\.setAttribute\\(['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
            "\\.setAttributeNS\\(.*,\\s*['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
            "class=\"([^\"]*)\"",
          ]
        }
      }
    }
  },
  "languages": {
    "Astro": { "formatter": { "language_server": { "name": "biome" } } },
    "CSS": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.action.useSortedProperties.biome": true,
        "source.fixAll.biome": true
      },
      "language_servers": [
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server"
      ]
    },
    "GraphQL": { "formatter": { "language_server": { "name": "biome" } } },
    "HTML": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.action.noDuplicateClasses.biome": true,
        "source.action.useSortedAttributes.biome": true,
        "source.fixAll.biome": true
      }
    },
    "JSON": { "formatter": { "language_server": { "name": "biome" } } },
    "JSONC": { "formatter": { "language_server": { "name": "biome" } } },
    "JSX": { "formatter": { "language_server": { "name": "biome" } } },
    "JavaScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "Svelte": { "formatter": { "language_server": { "name": "biome" } } },
    "TSX": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "TypeScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "Vue.js": { "formatter": { "language_server": { "name": "biome" } } }
  },
  "file_types": {
    "Helm": [
      "**/templates/**/*.tpl",
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
      "**/helmfile.d/**/*.yaml",
      "**/helmfile.d/**/*.yml",
      "**/values*.yaml"
    ]
  },
  // Zed built-in support: https://zed.dev/docs/languages
  "auto_install_extensions": {
    "ansible": true,
    "biome": true,
    "catppuccin-icons": true,
    "csv": true,
    "docker-compose": true,
    "dockerfile": true,
    "env": true,
    "git-firefly": true,
    "helm": true,
    "html": true,
    "java": true,
    "kotlin": true,
    "log": true,
    "lua": true,
    "make": true,
    "proto": true,
    "sql": true,
    "terraform": true,
    "tmux": true,
    "tokyo-night": true,
    "toml": true,
    "typos": true,
    "xml": true
  }
}
